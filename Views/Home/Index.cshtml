@{
    ViewData["Title"] = "Start";
}

<div class="p-4 p-md-5 mb-4 rounded-3 bg-light border shadow-sm">
    <div class="container-fluid py-2 py-md-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="badge text-bg-dark mb-3">BeFit</span>
                <h1 class="display-5 fw-bold mb-3">Trening pod kontrolą, bez przeklikiwania.</h1>
                <p class="col-lg-10 fs-5 text-muted mb-4">
                    Zarządzaj sesjami treningowymi, ćwiczeniami i typami ćwiczeń w jednym miejscu.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary btn-lg" asp-controller="TrainingSessions" asp-action="Index">Sesje treningowe</a>
                    <a class="btn btn-outline-secondary btn-lg" asp-controller="SessionExercises" asp-action="Index">Ćwiczenia</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="bg-white rounded-4 border p-4 shadow-sm">
                    <h2 class="h5 fw-semibold mb-3">Szybki dostęp</h2>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a asp-controller="TrainingSessions" asp-action="Index">Przegląd sesji treningowych</a></li>
                        <li class="mb-2"><a asp-controller="SessionExercises" asp-action="Index">Lista ćwiczeń w sesjach</a></li>
                        <li class="mb-2"><a asp-controller="ExerciseTypes" asp-action="Index">Słownik typów ćwiczeń</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li><a asp-controller="AdminUsers" asp-action="Create">Dodaj użytkownika</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
